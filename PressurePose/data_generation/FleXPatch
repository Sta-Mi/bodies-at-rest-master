-		const UINT subresource = D3D12_RESOURCE_BARRIER_ALL_SUBRESOURCES;
-		const D3D12_RESOURCE_BARRIER_FLAGS flags = D3D12_RESOURCE_BARRIER_FLAG_NONE;

-{ 
-	assert(index >= 0 && index < m_size);  
-	D3D12_CPU_DESCRIPTOR_HANDLE start = m_heap->GetCPUDescriptorHandleForHeapStart();
-	D3D12_CPU_DESCRIPTOR_HANDLE dst;
-	dst.ptr = start.ptr + m_descriptorSize * index;
-	return dst;
-}	

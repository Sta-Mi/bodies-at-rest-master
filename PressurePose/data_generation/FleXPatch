-#define NV_FACILITY_UNKNOWN      (NV_FACILITY_BASE + 3)
-#define NV_FACILITY_MEMORY		 (NV_FACILITY_BASE + 4)
-#define NV_FACILITY_MISC	     (NV_FACILITY_BASE + 5)

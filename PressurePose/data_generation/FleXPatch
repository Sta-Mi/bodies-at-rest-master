+    assert obj.say_something(3) == "BTBTBT"
+    assert obj.unlucky_number() == -7
+    assert obj.lucky_number() == -1.375
+    assert obj.say_everything() == "BT -7"
diff -ruN FleX/bindings/pybind11/tools/check-style.sh FleX_pose_estimation/bindings/pybind11/tools/check-style.sh
--- FleX/bindings/pybind11/tools/check-style.sh	1969-12-31 19:00:00.000000000 -0500
+++ FleX_pose_estimation/bindings/pybind11/tools/check-style.sh	2019-01-29 20:38:01.930160000 -0500

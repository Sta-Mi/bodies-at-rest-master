+void InputKeyboardUp(unsigned char key, int x, int y)
+{
+	switch (key)
+	{
+	case 'w':
+	case 's':
+	{
+		g_camVel.z = 0.0f;
+		break;
+	}
+	case 'a':
+	case 'd':
+	{
+		g_camVel.x = 0.0f;
+		break;
+	}
+	case 'q':
+	case 'z':
+	{
+		g_camVel.y = 0.0f;
+		break;
+	}
+	};

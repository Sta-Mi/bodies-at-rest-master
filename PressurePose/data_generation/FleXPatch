-	// map allocated vertex buffer
-	{
-		D3D11_MAPPED_SUBRESOURCE mappedResource = {};
-		if (S_OK == context->Map(m_vertexBuffer, 0u, D3D11_MAP_WRITE_NO_OVERWRITE, 0, &mappedResource))

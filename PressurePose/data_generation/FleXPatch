+int destroy_scene(){
+
+    cout << "C++ Destroying Scene!" << endl;
+
+	if (g_fluidRenderer)
+		DestroyFluidRenderer(g_fluidRenderer);
+
+	DestroyFluidRenderBuffers(g_fluidRenderBuffers);
+	DestroyDiffuseRenderBuffers(g_diffuseRenderBuffers);

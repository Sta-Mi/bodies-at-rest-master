-
-	// Set up constant buffer
-	NvCo::Dx12CircularResourceHeap::Cursor cursor;
-	{
-		Hlsl::PointShaderConst constBuf;
-		RenderParamsUtilD3D::calcPointConstantBuffer(params, constBuf);

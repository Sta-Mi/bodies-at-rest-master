-		srvHandleCPU = handle.cpuHandle;
-		srvHandleGPU = handle.gpuHandle;
-	}
-	else
-	{
-		if (m_srvUavHeapGPU == nullptr)
-		{
-			D3D12_DESCRIPTOR_HEAP_DESC srvHeapDesc = {};
-			srvHeapDesc.NumDescriptors = 1;

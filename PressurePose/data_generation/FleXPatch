+	virtual void Draw(int pass)
+	{
+		if (!g_drawMesh)
+			return;
+
+
+		for (int s = 0; s < int(mRenderingInstanceSofts.size()); ++s)
+		{
+			const RenderingInstanceSoft& instanceSoft = mRenderingInstanceSofts[s];
+
+			Mesh m;
+			m.m_positions.resize(instanceSoft.mMesh->m_positions.size());
+			m.m_normals.resize(instanceSoft.mMesh->m_normals.size());
+			m.m_indices = instanceSoft.mMesh->m_indices;
+
+			for (int i = 0; i < int(instanceSoft.mMesh->m_positions.size()); ++i) // for each particle in the skinning
+			{
+				Vec3 softPos;
+				Vec3 softNormal;
+
+				for (int w = 0; w < 4; ++w)
+				{
+					const int cluster = instanceSoft.mSkinningIndices[i * 4 + w];
+					const float weight = instanceSoft.mSkinningWeights[i * 4 + w];
+
+					if (cluster > -1)
+					{
+						// offset in the global constraint array
+						int rigidIndex = cluster + instanceSoft.mOffset;
+
+						Vec3 localPos = Vec3(instanceSoft.mMesh->m_positions[i]) - instanceSoft.mRigidRestPoses[cluster];
+
+						Vec3 skinnedPos = g_buffers->rigidTranslations[rigidIndex] + Rotate(g_buffers->rigidRotations[rigidIndex], localPos);
+						Vec3 skinnedNormal = Rotate(g_buffers->rigidRotations[rigidIndex], instanceSoft.mMesh->m_normals[i]);
+
+						softPos += skinnedPos*weight;
+						softNormal += skinnedNormal*weight;
+					}
+				}
+
+				m.m_positions[i] = Point3(softPos);
+				m.m_normals[i] = softNormal;
+                //cout << "new M pos " << m.m_positions[i]<< " Normal: " << Point3(softNormal) << endl;
+			}
+
+			DrawMesh(&m, instanceSoft.mColor);
+		}
+	}

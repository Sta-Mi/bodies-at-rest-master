+    cross1 = np.cross((bot_pos_array[0:27, 0:64, :] - bot_pos_array[1:28, 0:64, :]), (bot_pos_array[1:28, 1:65, :] - bot_pos_array[1:28, 0:64, :])).reshape(1728, 3)

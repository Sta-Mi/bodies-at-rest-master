+	ShadowDestroy(g_shadowMap);
+	Shutdown();
+	DestroyRender();
+	SDL_DestroyWindow(g_window);
+	SDL_Quit();
+
+	g_scenes[g_scene]->DestroyAssets();
+    cout << "got here 8" << endl;
+
+	return 0;
+}

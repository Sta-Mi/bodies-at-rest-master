+                    //cout <<  add_prev + GridIndex((dx+2)*int(z % 2 == 1) + dx - 1, y, dx + int(z % 2 == 1)) << " " << add_prev + GridIndex((y+1)*(dx - 1 + int(z % 2 == 0)) + y, dy + int(z % 2 == 1), dx + int(z % 2 == 1)) << " " <<  add_prev + GridIndex((y+1)*(dx - 1 + int(z % 2 == 0)) + y + dx + int(z % 2 == 0), dy + int(z % 2 == 1), dx + int(z % 2 == 1)) << endl;
+                }
+
+
+                //Make edges around the left side pointing down and right side pointing down
+                if (x == 0 && z < dz - 1 && y < dy - int(z % 2 == 0))
+                {
+                    g_buffers->triangles.push_back(baseIndex + add_prev + GridIndex(0, y, dx + int(z % 2 == 1)));
+                    g_buffers->triangles.push_back(baseIndex + add_prev + GridIndex(dx + int(z % 2 == 1), y, dx + int(z % 2 == 1)));
+                    g_buffers->triangles.push_back(baseIndex + add_prev + GridIndex((y + int(z % 2 == 0))*(dx + int(z % 2 == 0)), dy + int(z % 2 == 1), dx + int(z % 2 == 1)));
+                    g_buffers->triangleNormals.push_back(Vec3(0.0f, 0.5f, 0.5f));
+                    g_buffers->triangles.push_back(baseIndex + add_prev + GridIndex(2*(int(z % 2 == 1) + dx) - 1, y, dx + int(z % 2 == 1)));
+                    g_buffers->triangles.push_back(baseIndex + add_prev + GridIndex(int(z % 2 == 1) + dx - 1, y, dx + int(z % 2 == 1)));
+                    g_buffers->triangles.push_back(baseIndex + add_prev + GridIndex((y+1+int(z % 2 == 0))*(dx + int(z % 2 == 0)) - 1, dy + int(z % 2 == 1), dx + int(z % 2 == 1)));
+                    g_buffers->triangleNormals.push_back(Vec3(0.0f, 0.5f, 0.5f));
+                    //cout <<  add_prev + GridIndex(int(z % 2 == 1) + dx - 1, y, dx + int(z % 2 == 1)) << " " << add_prev + GridIndex(2*(int(z % 2 == 1) + dx) - 1, y, dx + int(z % 2 == 1)) << " " <<  add_prev + GridIndex((y+1+int(z % 2 == 0))*(dx + int(z % 2 == 0)) - 1, dy + int(z % 2 == 1), dx + int(z % 2 == 1)) << endl;
+                }
+
+                //Let the parameters of the top layer of the mat be different from the other layers
+                if (z == 0){
+                    stretchStiffness = stretchStiffness1;
+                    bendStiffness = bendStiffness1;
+                    shearStiffness = shearStiffness1;
+                    padStiffness = padStiffness1;
+                }
+                else if (z == 1){
+                    stretchStiffness = stretchStiffness2;
+                    bendStiffness = bendStiffness2;
+                    shearStiffness = shearStiffness2;
+                    padStiffness = padStiffness1;
+                }
+                else {
+                    stretchStiffness = stretchStiffness2;
+                    bendStiffness = bendStiffness2;
+                    shearStiffness = shearStiffness2;
+                    padStiffness = padStiffness2;
+                }
+
+
+                int indexH0 = y*dx + x + add_prev;
+                if ( z % 2 == 1 )
+                    indexH0 = y*(dx+1) + x + add_prev;
+
+                //horizontal stretch
+                if (x > 0)
+                {
+                    if ( z % 2 == 0 )
+                    {
+                        if ( y < dy && x < dx)
+                        {
+                            int indexH1 = y*dx + x - 1 + add_prev;
+                            CreateSpring(baseIndex + indexH0, baseIndex + indexH1, stretchStiffness);
+                        }
+                    }
+                    else
+                    {
+                        int indexH1 = y*(dx+1) + x - 1 + add_prev;
+                        CreateSpring(baseIndex + indexH0, baseIndex + indexH1, stretchStiffness);
+                    }
+
+                }
+
+                //horizontal bend
+                if (x > 1)
+                {
+                    if ( z % 2 == 0 )
+                    {
+                        if ( y < dy && x < dx)
+                        {
+                            int indexH2 = y*dx + x - 2 + add_prev;
+                            CreateSpring(baseIndex + indexH0, baseIndex + indexH2, bendStiffness);
+                        }
+                    }
+                    else
+                    {
+                        int indexH2 = y*(dx+1) + x - 2 + add_prev;
+                        CreateSpring(baseIndex + indexH0, baseIndex + indexH2, bendStiffness);
+                    }
+                }
+
+                //facing into the page stretch
+                if (y > 0)
+                {
+                    if ( z % 2 == 0 )
+                    {
+                        if ( y < dy && x < dx)
+                        {
+                            int indexV1 = (y-1)*dx + x + add_prev;
+                            CreateSpring(baseIndex + indexH0, baseIndex + indexV1, stretchStiffness);
+                        }
+                    }
+                    else
+                    {
+
+                        int indexV1 = (y-1)*(dx+1) + x + add_prev;
+                        CreateSpring(baseIndex + indexH0, baseIndex + indexV1, stretchStiffness);
+                    }
+                }
+
+                //facing into the page bend
+                if (y > 1)
+                {
+                    if ( z % 2 == 0 )
+                    {
+                        if ( y < dy && x < dx)
+                        {
+                            int indexV2 = (y-2)*dx + x + add_prev;
+                            CreateSpring(baseIndex + indexH0, baseIndex + indexV2, bendStiffness);
+                        }
+                    }
+                    else
+                    {
+                        int indexV2 = (y-2)*(dx+1) + x + add_prev;
+                        CreateSpring(baseIndex + indexH0, baseIndex + indexV2, bendStiffness);
+                    }
+                }
+
+
+                //shear springs 1
+                if (x > 0 && y > 0)
+                {
+                    if ( z % 2 == 0 )
+                    {
+                        if ( y < dy && x < dx)
+                        {
+                            int indexD1 = y*dx + x - dx - 1 + add_prev;
+                            int indexD2 = y*dx + x - dx + add_prev;
+                            CreateSpring(baseIndex + indexH0 - 1, baseIndex + indexD2, shearStiffness);
+                            CreateSpring(baseIndex + indexH0, baseIndex + indexD1, shearStiffness);
+                        }
+                    }
+                    else
+                    {
+                        int indexD1 = y*(dx+1) + x - dx - 2 + add_prev;
+                        int indexD2 = y*(dx+1) + x - dx - 1 + add_prev;
+                        CreateSpring(baseIndex + indexH0 - 1, baseIndex + indexD2, shearStiffness);
+                        CreateSpring(baseIndex + indexH0, baseIndex + indexD1, shearStiffness);
+                    }
+                }
+
+
+                //diagonal springs going down and up from the ground
+                if (z > 0)
+                {
+                    if ( z % 2 == 1 )
+                    {
+                        if (x < dx && y < dy)
+                        {
+                            CreateSpring(baseIndex + indexH0, baseIndex + indexH0 - dx*dy - y, padStiffness);
+                            CreateSpring(baseIndex + indexH0 + 1, baseIndex + indexH0 - dx*dy - y, padStiffness);
+                            CreateSpring(baseIndex + indexH0 + dx + 1, baseIndex + indexH0 - dx*dy - y, padStiffness);
+                            CreateSpring(baseIndex + indexH0 + dx + 2, baseIndex + indexH0 - dx*dy - y, padStiffness);
+                        }
+                    }
+
+                    else
+                    {
+                        if (x < dx && y < dy)
+                        {
+                            CreateSpring(baseIndex + indexH0, baseIndex +  indexH0 - (dx+1)*(dy+1) + y, padStiffness);
+                            CreateSpring(baseIndex + indexH0, baseIndex +  indexH0 - (dx+1)*(dy+1) + y + 1, padStiffness);
+                            CreateSpring(baseIndex + indexH0, baseIndex +  indexH0 - (dx+1)*(dy+1) + y + dx + 1, padStiffness);
+                            CreateSpring(baseIndex + indexH0, baseIndex +  indexH0 - (dx+1)*(dy+1) + y + dx + 2, padStiffness);
+                        }
+                    }
+                }
+            }
+        }
+        if (z % 2 == 0)
+        {
+            add_prev += dx*dy;
+        }
+        else
+        {
+            add_prev += (dx+1)*(dy+1);
+        }
+    }
+}

+
+    for i in range(0, top_len):
+        top_pos_array[i, 0] = flexbind.grab_x_pos_particle(i)
+        top_pos_array[i, 1] = flexbind.grab_y_pos_particle(i)
+        top_pos_array[i, 2] = flexbind.grab_z_pos_particle(i)
+
+    for i in range(0, bot_len):
+        bot_pos_array[i, 0] = flexbind.grab_x_pos_particle(i + top_len)
+        bot_pos_array[i, 1] = flexbind.grab_y_pos_particle(i + top_len)
+        bot_pos_array[i, 2] = flexbind.grab_z_pos_particle(i + top_len)
+
+    top_pos_array = np.reshape(top_pos_array, (33, 68, 3))  # [3:30, 2:66, :]
+    bot_pos_array = np.reshape(bot_pos_array, (34, 69, 3))  # [3:31, 2:67, :]
+
+    # get the average of the two normal planes in each underlying quad, defined by two triangles with
+    # two coincident edges
+    cross1 = np.cross((bot_pos_array[0:33, 0:68, :] - bot_pos_array[1:34, 0:68, :]),
+                      (bot_pos_array[1:34, 1:69, :] - bot_pos_array[1:34, 0:68, :])).reshape(2244, 3)
+    cross2 = np.cross((bot_pos_array[1:34, 1:69, :] - bot_pos_array[0:33, 1:69, :]),
+                      (bot_pos_array[0:33, 0:68, :] - bot_pos_array[0:33, 1:69, :])).reshape(2244, 3)
+
+    # non normalized direction
+    N = (cross1 + cross2) / 2
+    # print "N: ", N
+
+    # N_opp_force_dir = -(N/np.linalg.norm(N, axis = 1).reshape(2244, 1)).reshape(33, 68, 3)
+
+    a = -np.sum(np.multiply(N, bot_pos_array[0:33, 0:68, :].reshape(2244, 3)), axis=1)
+    dp = np.sum(np.multiply(N, top_pos_array.reshape(2244, 3)), axis=1)
+    d = (dp + a) / np.linalg.norm(N, axis=1)
+
+    # need to get the distance plunging in rather than the subtracted one.
+    # print stack_spacing + 0.015
+    # print float(np.argmax(np.bincount((np.abs(d)*1000).astype(int)))-2)*0.001
+
+    d_zero_out = np.abs(d) * 1000
+    d_zero_out = d_zero_out.astype(int)
+    d_zero_out[d_zero_out < 1] = 1
+    d_zero_out[d_zero_out > 100000] = 100000
+    # print len(d_zero_out), d_zero_out,
+    d_zero_out = np.bincount(d_zero_out)
+    # print len(d_zero_out), d_zero_out,
+    d_zero_out = np.argmax(d_zero_out)
+    # print d_zero_out,
+    d_zero_out -= 1
+    # print d_zero_out,
+    d_zero_out = float(d_zero_out)
+    # print d_zero_out,
+    d_zero_out *= 0.001
+    # print d_zero_out
+
+    d = d.reshape(33, 68)
+    d += d_zero_out
+    # d = d.reshape(33,68) + float(np.argmax(np.bincount((np.abs(d)*1000).astype(int)))-1)*0.001
+
+    d = np.flipud(np.transpose(d))
+
+    d_nonzero = d > 0
+
+    p_mat = d * d * p_quad + d * p_multiplier + p_offset
+
+    p_mat_no_noise = np.copy(p_mat)
+    p_mat_no_noise *= d_nonzero
+    p_mat_no_noise = np.clip(p_mat_no_noise, 0, 100)
+
+    # p_mat += p_mat * p_mat * p_quad
+
+    p_mat *= d_nonzero
+    p_mat = np.clip(p_mat, 0, 100)
+
+    # print p_mat.shape
+
+    #p_mat[p_mat > 0] += 15
+    #target_chosen[target_chosen > 0] += 15
+
+    p_mat = gaussian_filter(p_mat, sigma=0.5)
+    target_chosen = gaussian_filter(target_chosen, sigma=0.5)
+
+    if plot == True:
+        plt.gca().clear()
+
+        plt.imshow(np.concatenate((target_chosen, p_mat), axis=1), interpolation='nearest', vmin=0, vmax=100,
+                   cmap=plt.cm.jet, origin='upper')
+        # if COLOR_BAR == True:
+        #    plt.colorbar()
+        #    COLOR_BAR = False
+        mypause(0.01)
+
+    #sleep(0.5)
+    return p_mat, target_chosen

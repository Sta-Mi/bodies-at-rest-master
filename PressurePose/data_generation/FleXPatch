+
+                }
+            }
+
+
+        }
+
+
+        //fix the mattress so it doesn't crumble in on itself. fix mattress buffers is a collection of original particle positions on the bottomish part of the head of the bed
+        for (int i = MAT_HEIGHT*MAT_WIDTH + (MAT_HEIGHT+1)*(MAT_WIDTH+1); i < g_fixMattressBuffers->positions.size(); ++i)

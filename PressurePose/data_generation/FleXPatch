-	Scissor& p = m_stateScissor;
-	int winH = m_desc.winH;
-	D3D12_RECT rect;
-	rect.left = p.x;
-	rect.right = p.x + p.width;
-	rect.top = (winH) - (p.y + p.height);
-	rect.bottom = (winH) - (p.y);
-	commandList->RSSetScissorRects(1, &rect);
-}

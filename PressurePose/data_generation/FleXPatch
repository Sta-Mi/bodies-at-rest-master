+		if (g_fluidRenderer)
+			DestroyFluidRenderer(g_fluidRenderer);
+		g_fluidRenderer = CreateFluidRenderer(width, height);
+	}
+
+	g_screenWidth = width;
+	g_screenHeight = height;

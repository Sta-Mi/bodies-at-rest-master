+void DrawArrows(std::vector<float> input_mat_forces)
+{
+    std::vector<float> arrow_x;
+    std::vector<float> arrow_y;
+    std::vector<float> arrow_z;
+    std::vector<float> arrow_u;
+    std::vector<float> arrow_v;
+    std::vector<float> arrow_w;
+    std::vector<float> d_pen;
+    std::vector<float> d_pen_r;
+    std::vector<float> d_pen_g;
+    std::vector<float> d_pen_b;
+    std::vector<float> rad;
+
+    int num_arrows = input_mat_forces.size()/11;
+
+    for (int all_dat_idx = 0; all_dat_idx < num_arrows; all_dat_idx ++)
+    {
+        arrow_x.push_back(input_mat_forces[all_dat_idx]);
+        arrow_y.push_back(input_mat_forces[1*num_arrows + all_dat_idx]);
+        arrow_z.push_back(input_mat_forces[2*num_arrows + all_dat_idx]);
+        arrow_u.push_back(input_mat_forces[3*num_arrows + all_dat_idx]);
+        arrow_v.push_back(input_mat_forces[4*num_arrows + all_dat_idx]);
+        arrow_w.push_back(input_mat_forces[5*num_arrows + all_dat_idx]);
+        d_pen.push_back(input_mat_forces[6*num_arrows + all_dat_idx]);
+        d_pen_r.push_back(input_mat_forces[7*num_arrows + all_dat_idx]);
+        d_pen_g.push_back(input_mat_forces[8*num_arrows + all_dat_idx]);
+        d_pen_b.push_back(input_mat_forces[9*num_arrows + all_dat_idx]);
+        rad.push_back(input_mat_forces[10*num_arrows + all_dat_idx]);
+    }
+
+    Mesh* origArrow = ImportMeshFromObj("/home/henry/git/FleX_pose_estimation/data/sun_dial_arrow.obj", 0.0f, 0.5f, 0.0f);
+
+    origArrow->Transform(RotationMatrix(Quat(0.7071f, 0.0f, 0.0f, 0.7071f)));
+
+
+    for (int i = 0; i < num_arrows; ++i)
+    {
+        Vec3 xyz = Cross(Vec3(1.0f,0.0f,0.0f), Vec3(arrow_u[i], arrow_v[i], arrow_w[i]));
+        Quat curr_arrow_rot;
+        curr_arrow_rot[0] = xyz[0];
+        curr_arrow_rot[1] = xyz[1];
+        curr_arrow_rot[2] = xyz[2];
+        curr_arrow_rot[3] = arrow_u[i];
+
+        Mesh Arrow2;
+        Arrow2.AddMesh(*origArrow);
+        Mesh* Arrow1 = &Arrow2;
+
+        // CHANGE ARROW SIZE IN SCALE MATRIX BELOW
+        //Matrix44 xform1 = TranslationMatrix(Point3(arrow_x[i], arrow_y[i], arrow_z[i]))*RotationMatrix(curr_arrow_rot)*ScaleMatrix(Vec3(0.5f, 0.3f, 0.5f)*d_pen[i]);
+        Matrix44 xform1;
+        if (g_drawMatArrows == true)
+        {
+            xform1 = TranslationMatrix(Point3(arrow_x[i], arrow_y[i], arrow_z[i]))*RotationMatrix(curr_arrow_rot)*ScaleMatrix(Vec3(0.5f, 0.3f, 0.5f)*d_pen[i]);
+        }
+        else if (g_drawCapArrows == true && show_capsules == false)
+        {
+            xform1 = TranslationMatrix(Point3(arrow_x[i], arrow_y[i], arrow_z[i]))*RotationMatrix(curr_arrow_rot)*ScaleMatrix(Vec3(0.5f, 0.5f, 0.5f)*d_pen[i]);
+        }
+        else if (g_drawCapArrows == true && show_capsules == true)
+        {
+            xform1 = TranslationMatrix(Point3(arrow_x[i], arrow_y[i]+rad[i], arrow_z[i]))*RotationMatrix(curr_arrow_rot)*ScaleMatrix(Vec3(0.5f, 0.5f, 0.5f)*d_pen[i]);
+        }
+
+        Arrow1->Transform(xform1);
+        DrawMesh(Arrow1, Vec3(d_pen_r[i], d_pen_g[i], d_pen_b[i]));
+        //delete Arrow1;
+        //delete Arrow;
+    }
+    delete origArrow;
+}

+bool AssignParamBool(py::dict new_param_dict, std::string nameDesired)
+{
+    for (auto item : new_param_dict)
+    {
+        key = py::str(item.first);
+        if (nameDesired == key)
+        {
+            value = py::str(item.second);
+            if ( value == "True")
+                return true;
+            else if (value == "False")
+                return false;
+            else
+                throw Error("Could not convert the '%s' you entered to a bool.", key.c_str());
+        }
+    }
+    throw Error("Requires definition of param '%s' in the dictionary.", nameDesired.c_str());
+}
+
+int AssignParamInt(py::dict new_param_dict, std::string nameDesired)
+{
+    for (auto item : new_param_dict)
+    {
+        key = py::str(item.first);
+        if (nameDesired == key)
+        {
+            value = py::str(item.second);
+            const char *value_char = value.c_str();
+            int int_value;
+            if(sscanf(value_char, "%i", &int_value) != 1)
+                throw Error("Could not convert the '%s' you entered to an int.", key.c_str());
+            else
+                return int_value;
+        }
+    }
+    throw Error("Requires definition of param '%s' in the dictionary.", nameDesired.c_str());
+}
+
+float AssignParamFloat(py::dict new_param_dict, std::string nameDesired)
+{
+    for (auto item : new_param_dict)

-class Dx12DescriptorHeap
-{
-	//NV_CO_DECLARE_CLASS_BASE(Dx12DescriptorHeap);
-public:
-		/// Initialize
-	int init(ID3D12Device* device, int size, D3D12_DESCRIPTOR_HEAP_TYPE type, D3D12_DESCRIPTOR_HEAP_FLAGS flags);

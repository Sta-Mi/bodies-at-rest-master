+                        g_buffers->positions[gbuf_idx].z = float(g_fixMattressBuffers->positions[pmat_idx].z);
+                        g_buffers->velocities[gbuf_idx].x = 0.0f;
+                        g_buffers->velocities[gbuf_idx].y = 0.0f;
+                        g_buffers->velocities[gbuf_idx].z = 0.0f;
+                    }
+                }
+            }
+
+
+            for (int y = 0; y < MAT_WIDTH; ++y){ //top level of mat stuff
+                for (int x = 0; x < MAT_HEIGHT; ++x){
+                    pmat_idx = y*(MAT_HEIGHT) + x;
+                    if (x >= 67 - int(shrink_pmat/0.075)){
+                        //cout << "x top: " << x << " subtr pix: " << 69 - x - int(shrink_pmat/0.075) << "  subtr len: "<< 0.075*float(std::min(0, 69 - x - int(shrink_pmat/0.075))) << endl;
+                        x_i = float(g_fixMattressBuffers->positions[pmat_idx].x) + shrink_pmat + 0.074*float(std::min(0, 68 - x - int(shrink_pmat/0.075)));
+                        y_i = float(g_fixMattressBuffers->positions[pmat_idx].y) - 0.05;
+                        gbuf_idx = int(g_fixMattressBuffers->positions[pmat_idx].w);
+                        g_buffers->positions[gbuf_idx].x = (x_i - head_bend)*cos_th - (y_i)*sin_th + head_bend;
+                        g_buffers->positions[gbuf_idx].y = (x_i - head_bend)*sin_th + (y_i)*cos_th;
+                        g_buffers->positions[gbuf_idx].z = float(g_fixMattressBuffers->positions[pmat_idx].z);
+                        g_buffers->positions[gbuf_idx].w = 0.0f;
+                        g_buffers->velocities[gbuf_idx].x = 0.0f;
+                        g_buffers->velocities[gbuf_idx].y = 0.0f;
+                        g_buffers->velocities[gbuf_idx].z = 0.0f;
+
+                    }
+
+                    //fix the top layer particles as the mat is moving up
+                    if (x < MAT_HEIGHT && y < MAT_WIDTH && x >= 60 && tan_th < 1.732){
+                        x_i = float(g_fixMattressBuffers->positions[pmat_idx].x) + shrink_pmat + 0.074*float(std::min(0, 68 - x - int(shrink_pmat/0.075)));
+                        y_i = float(g_fixMattressBuffers->positions[pmat_idx].y) - 0.05f;
+                        gbuf_idx = int(g_fixMattressBuffers->positions[pmat_idx].w);
+                        g_buffers->positions[gbuf_idx].x = (x_i - head_bend)*cos_th - (y_i)*sin_th + head_bend;
+                        g_buffers->positions[gbuf_idx].y = (x_i - head_bend)*sin_th + (y_i)*cos_th;
+                        g_buffers->positions[gbuf_idx].z = float(g_fixMattressBuffers->positions[pmat_idx].z);
+                        g_buffers->velocities[gbuf_idx].x = 0.0f;
+                        g_buffers->velocities[gbuf_idx].y = 0.0f;
+                        g_buffers->velocities[gbuf_idx].z = 0.0f;
+                    }
+
+
+                }
+            }
+
+        }
+        else //do not pull it to flatten. this is for the case of the voxelized human meshing.
+        {
+            //fix the pressure mat so it doesn't crumble. start at the second layer
+            for (int y = 0; y < MAT_WIDTH+1; ++y){
+                for (int x = 0; x < MAT_HEIGHT+1; ++x){
+                    pmat_idx = MAT_HEIGHT*MAT_WIDTH + y*(MAT_HEIGHT+1) + x;
+                    if ((x >= 67 || (x > 52 && y <= 1) || (x > 52 && y >=  MAT_WIDTH - 1)) && tan_th > 1.732){
+                        x_i = float(g_fixMattressBuffers->positions[pmat_idx].x);
+                        y_i = float(g_fixMattressBuffers->positions[pmat_idx].y) - 0.05f;
+                        gbuf_idx = int(g_fixMattressBuffers->positions[pmat_idx].w);
+                        g_buffers->positions[gbuf_idx].x = (x_i - head_bend)*cos_th - (y_i)*sin_th + head_bend;
+                        g_buffers->positions[gbuf_idx].y = (x_i - head_bend)*sin_th + (y_i)*cos_th;
+                        g_buffers->positions[gbuf_idx].z = float(g_fixMattressBuffers->positions[pmat_idx].z);
+                        g_buffers->velocities[gbuf_idx].x = 0.0f;
+                        g_buffers->velocities[gbuf_idx].y = 0.0f;
+                        g_buffers->velocities[gbuf_idx].z = 0.0f;
+                    }
+
+                    //fix the bottom layer particles as the mat is moving up
+                    if (x >= 53 && tan_th < 1.732){
+                        x_i = float(g_fixMattressBuffers->positions[pmat_idx].x);
+                        y_i = float(g_fixMattressBuffers->positions[pmat_idx].y) - 0.05f;
+                        gbuf_idx = int(g_fixMattressBuffers->positions[pmat_idx].w);
+                        g_buffers->positions[gbuf_idx].x = (x_i - head_bend)*cos_th - (y_i)*sin_th + head_bend;
+                        g_buffers->positions[gbuf_idx].y = (x_i - head_bend)*sin_th + (y_i)*cos_th;
+                        g_buffers->positions[gbuf_idx].z = float(g_fixMattressBuffers->positions[pmat_idx].z);
+                        g_buffers->velocities[gbuf_idx].x = 0.0f;
+                        g_buffers->velocities[gbuf_idx].y = 0.0f;
+                        g_buffers->velocities[gbuf_idx].z = 0.0f;
+                    }
+
+
+                    //kill the particle velocity right after it reaches the top
+                    if (x >= 50 && tan_th >= 1.732 && KILL_SITTING_MAT == true){
+                        x_i = float(g_fixMattressBuffers->positions[pmat_idx].x);
+                        y_i = float(g_fixMattressBuffers->positions[pmat_idx].y) - 0.05f;
+                        gbuf_idx = int(g_fixMattressBuffers->positions[pmat_idx].w);
+                        //g_buffers->positions[gbuf_idx].y = (x_i - head_bend)*sin_th + (y_i)*cos_th;
+                        //g_buffers->positions[gbuf_idx].y = (0.151f*float(x) - 4.218f - g_buffers->positions[gbuf_idx].x)/tan_th + y_i;
+                        //g_buffers->positions[gbuf_idx].x = 0.151f*float(x) - 4.218f - (g_buffers->positions[gbuf_idx].y - y_i) * tan_th;
+                        g_buffers->velocities[gbuf_idx].x = 0.0f;
+                        g_buffers->velocities[gbuf_idx].y = 0.0f;
+                        g_buffers->velocities[gbuf_idx].z = 0.0f;
+                        KILL_SITTING_MAT = false;
+                    }
+
+
+                    //fix the top layer particles as the mat is moving up
+                    pmat_idx = y*(MAT_HEIGHT) + x;
+                    if (x < MAT_HEIGHT && y < MAT_WIDTH && x >= 60 && tan_th < 1.732){
+                        x_i = float(g_fixMattressBuffers->positions[pmat_idx].x);
+                        y_i = float(g_fixMattressBuffers->positions[pmat_idx].y) - 0.05f;
+                        gbuf_idx = int(g_fixMattressBuffers->positions[pmat_idx].w);
+                        g_buffers->positions[gbuf_idx].x = (x_i - head_bend)*cos_th - (y_i)*sin_th + head_bend;
+                        g_buffers->positions[gbuf_idx].y = (x_i - head_bend)*sin_th + (y_i)*cos_th;

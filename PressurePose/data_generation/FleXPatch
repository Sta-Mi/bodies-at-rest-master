+                marker.action = marker.ADD
+                marker.scale.x = 0.05
+                marker.scale.y = 0.05
+                marker.scale.z = 0.05
+                marker.color.a = 1.0
+                if image[j,i] > 60:
+                    marker.color.r = 1.
+                    marker.color.b = (100 - image[j, i])*.9 / 60.
+                else:
+                    marker.color.r = image[j, i] / 40.
+                    marker.color.b = 1.
+                marker.color.g = (70-np.abs(image[j,i]-50))/100.
+
+                marker.pose.orientation.w = 1.0
+
+                marker.pose.position.x = i*0.0286
+                if j > 33:

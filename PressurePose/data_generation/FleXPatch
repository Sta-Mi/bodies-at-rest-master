-#define NV_GET_RESULT_SEVERITY(r)	((int)(((NvUInt32)(r)) >> 31))
-//! Will be 0 - for ok, 1 for failure
-#define NV_GET_RESULT_FACILITY(r)	((int)(((r) >> 16) & 0x7fff))
